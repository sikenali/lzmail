# LZMail Docker Compose 环境变量模板
# 复制此文件为 .env 并修改相应的值：cp .env.docker.example .env
# 默认情况下无需任何配置即可直接 docker-compose up -d

# ===========================================
# 🔨 构建参数
# ===========================================

# 基础镜像（可指向内部镜像缓存 / registry mirror）
GO_BASE_IMAGE=golang:1.25-alpine
NODE_BASE_IMAGE=node:20-alpine

# 前端访问后端 API 的地址（构建时内联，默认同机部署 localhost 即可）
NEXT_PUBLIC_API_URL=http://localhost:8080

# ===========================================
# ⚙️ 运行配置
# ===========================================

# 邮件存储容量上限（GB）
STORAGE_LIMIT_GB=50

# 容器时区
TZ=Asia/Shanghai

# ===========================================
# 📋 使用说明
# ===========================================
#
# 1. 复制此文件为 .env: cp .env.docker.example .env
# 2. 按需修改配置项
# 3. 启动服务: docker-compose up -d
# 4. 访问 http://localhost:3000
#
# 重要提醒:
# - 前端(3000)与后端(8080)均通过端口映射暴露
# - 数据持久化在 Docker 卷 lzmail_data / lzmail_archives 中，升级时不会丢失
# - 若需远程访问，请将 NEXT_PUBLIC_API_URL 改为 http://<服务器IP>:8080 后重新构建
