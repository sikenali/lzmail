[Unit]
Description=lzmail backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lzmail
ExecStart=/opt/lzmail/lzmail-server
Restart=always
RestartSec=5
Environment=PORT=8080
Environment=DATA_DIR=/opt/lzmail/data
Environment=ARCHIVE_DIR=/opt/lzmail/archives

[Install]
WantedBy=multi-user.target